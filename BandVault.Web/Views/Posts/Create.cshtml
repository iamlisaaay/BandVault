@model BandVault.Web.Models.Post

<div class="container my-5 w-50">
    <h3 class="mb-4">Написати пост</h3>
    <form asp-action="Create" data-turbo="false">
        <div class="mb-3">
            <label asp-for="Title" class="form-label text-secondary meta-text">ЗАГОЛОВОК</label>
            <input asp-for="Title" class="form-control bg-dark text-white border-secondary rounded-0" required />
        </div>

        <div class="mb-3">
            <label asp-for="RequiredTierLevel" class="form-label text-secondary meta-text">ДОСТУП ДО ПОСТА (TIER)</label>
            <select asp-for="RequiredTierLevel" class="form-select bg-dark text-white border-secondary rounded-0" asp-items="ViewBag.Tiers">
            </select>
        </div>

        <div class="mb-4">
            <label asp-for="ContentMarkdown" class="form-label text-secondary meta-text">КОНТЕНТ (ПІДТРИМУЄ DRAG-N-DROP МЕДІА)</label>
            <textarea asp-for="ContentMarkdown" id="ContentMarkdown" class="form-control bg-dark text-white border-secondary rounded-0" rows="10"></textarea>
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsPublished" class="form-check-input bg-dark border-secondary rounded-0" type="checkbox" checked>
            <label class="form-check-label text-white" asp-for="IsPublished">
                Опублікувати одразу
            </label>
        </div>

        <button type="submit" class="btn btn-light rounded-0 w-100 fw-bold">ОПУБЛІКУВАТИ</button>
    </form>
</div>
@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
    <script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
    <style>
        .editor-toolbar {
            border-color: #6c757d;
            background-color: #1a1a1a;
        }

            .editor-toolbar button {
                color: #fff !important;
            }

                .editor-toolbar button:hover, .editor-toolbar button.active {
                    background-color: #333;
                }

        .CodeMirror {
            background-color: #121212;
            color: #fff;
            border-color: #6c757d;
        }

        .editor-preview {
            background-color: #121212;
        }

        .CodeMirror-cursor {
            border-left: 2px solid #fff !important;
        }
    </style>

    <script>
        function initMarkdownEditor() {
            const textArea = document.getElementById('ContentMarkdown');
            if (!textArea) return;

            if (window.bandvaultMde) {
                window.bandvaultMde.toTextArea();
                window.bandvaultMde = null;
            }

            window.bandvaultMde = new EasyMDE({
                element: textArea,
                spellChecker: false,
                autosave: {
                    enabled: true,
                    uniqueId: "bandvault_post_draft",
                    delay: 1000,
                },
                uploadImage: true,
                // EasyMDE хай ловить ТІЛЬКИ картинки
                imageAccept: "image/*",
                imageUploadFunction: function(file, onSuccess, onError) {
                    uploadMediaFile(file, window.bandvaultMde.codemirror, onSuccess, onError);
                }
            });

            // Наш кастомний перехоплювач для АУДІО ТА ВІДЕО вішаємо на весь редактор
            const editorWrapper = textArea.nextSibling;

            editorWrapper.addEventListener('dragover', function(e) {
                e.preventDefault();
            });

            editorWrapper.addEventListener('drop', function(e) {
                if (e.dataTransfer.files.length > 0) {
                    var file = e.dataTransfer.files[0];
                    // Якщо це аудіо або відео - перехоплюємо і НЕ ДАЄМО EasyMDE його побачити
                    if (file.type.match('audio.*') || file.type.match('video.*')) {
                        e.preventDefault();
                        e.stopPropagation();

                        uploadMediaFile(file, window.bandvaultMde.codemirror,
                            (url) => {},
                            (err) => { alert(err); }
                        );
                    }
                }
            }, true); // true - фаза перехоплення (capture), щоб спрацювати ПЕРШИМИ

            setTimeout(() => {
                if (window.bandvaultMde && window.bandvaultMde.codemirror) {
                    window.bandvaultMde.codemirror.refresh();
                }
            }, 100);
        }

        function uploadMediaFile(file, editor, onSuccess, onError) {
            if (file.size > 20 * 1024 * 1024) {
                onError("Файл занадто великий! Дозволено до 20 МБ.");
                return;
            }

            var formData = new FormData();
            formData.append("file", file);

            var placeholder = `![Uploading ${file.name}...]()`;
            var isMedia = file.type.match('audio.*') || file.type.match('video.*');

            if (isMedia) {
                var doc = editor.getDoc();
                var cursor = doc.getCursor();
                doc.replaceRange(placeholder, cursor);
            }

            fetch('/Posts/UploadMedia', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.type === 'image') {
                    onSuccess(data.url);
                } else {
                    var doc = editor.getDoc();
                    var text = doc.getValue();
                    var newText = text.replace(placeholder,
                        data.type === 'video' ? `\n<video controls style="width:100%; border-radius:8px; margin: 10px 0;"><source src="${data.url}"></video>\n` :
                        `\n<audio controls class="w-100" style="margin: 10px 0;"><source src="${data.url}"></audio>\n`
                    );
                    doc.setValue(newText);
                }
            })
            .catch(err => {
                onError("Помилка завантаження: " + err.toString());
                if (isMedia) {
                    var doc = editor.getDoc();
                    doc.setValue(doc.getValue().replace(placeholder, ""));
                }
            });
        }

        document.addEventListener("turbo:before-cache", function() {
            if (window.bandvaultMde) {
                window.bandvaultMde.toTextArea();
                window.bandvaultMde = null;
            }
        });

        document.removeEventListener("turbo:load", initMarkdownEditor);
        document.addEventListener("turbo:load", initMarkdownEditor);

        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            initMarkdownEditor();
        } else {
            document.addEventListener("DOMContentLoaded", initMarkdownEditor);
        }
    </script>
}
}