@model BandVault.Web.Models.Post

<div class="container my-5 w-75">
    <h3 class="mb-4">Написати пост</h3>
    <form asp-action="Create" data-turbo="false" id="postForm">
        <div class="mb-3">
            <label asp-for="Title" class="form-label text-secondary meta-text">ЗАГОЛОВОК</label>
            <input asp-for="Title" class="form-control bg-dark text-white border-secondary rounded-0" required />
        </div>

        <div class="mb-3">
            <label asp-for="RequiredTierLevel" class="form-label text-secondary meta-text">ДОСТУП ДО ПОСТА (TIER)</label>
            <select asp-for="RequiredTierLevel" class="form-select bg-dark text-white border-secondary rounded-0" asp-items="ViewBag.Tiers">
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label text-secondary meta-text">КОНТЕНТ (DRAG-N-DROP СОРТУВАННЯ ТА МЕДІА)</label>
            <div id="editor-blocks" class="mb-3 p-3 border border-secondary" style="min-height: 200px; background-color: #121212;">
                <!-- Тут будуть створюватись блоки -->
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-light btn-sm rounded-0" onclick="addTextBlock()">+ Текст</button>
                <button type="button" class="btn btn-outline-light btn-sm rounded-0" onclick="document.getElementById('mediaUpload').click()">+ Медіа (Відео/Аудіо)</button>
                <!-- Відео та Аудіо ми додаємо як окремі блоки -->
                <input type="file" id="mediaUpload" style="display: none;" accept="audio/*, video/*" onchange="uploadMedia(this)" />
            </div>

            <input type="hidden" asp-for="ContentMarkdown" id="ContentMarkdown" />
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsPublished" class="form-check-input bg-dark border-secondary rounded-0" type="checkbox" checked>
            <label class="form-check-label text-white" asp-for="IsPublished">
                Опублікувати одразу
            </label>
        </div>

        <button type="button" onclick="saveAndSubmit()" class="btn btn-light rounded-0 w-100 fw-bold">ОПУБЛІКУВАТИ</button>
    </form>
</div>

@section Scripts {
    <!-- Підключаємо і SortableJS, і EasyMDE -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
    <script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>

    <style>
        .block-item {
            background-color: #1a1a1a;
            border: 1px solid #333;
            margin-bottom: 10px;
            padding: 10px;
            display: flex;
            align-items: stretch;
            gap: 10px;
            transition: border-color 0.2s;
        }

        .block-item:focus-within { border-color: #6c757d; }

        .drag-handle {
            cursor: grab;
            color: #666;
            padding: 5px;
            font-size: 1.2rem;
            user-select: none;
            display: flex;
            align-items: center;
        }
        .drag-handle:active { cursor: grabbing; }

        .block-content { flex-grow: 1; min-width: 0; }
        
        /* Стилі для міні-редакторів */
        .editor-toolbar { border-color: #444; background-color: #1a1a1a; padding: 0 5px; opacity: 0.5; transition: opacity 0.3s; }
        .block-item:focus-within .editor-toolbar { opacity: 1; border-color: #6c757d; }
        .editor-toolbar button { color: #fff !important; }
        .editor-toolbar button:hover, .editor-toolbar button.active { background-color: #333; }
        .CodeMirror { background-color: #121212; color: #fff; border-color: #444; min-height: 80px; height: auto; }
        .block-item:focus-within .CodeMirror { border-color: #6c757d; }
        .editor-preview { background-color: #121212; }
        .CodeMirror-cursor { border-left: 2px solid #fff !important; }
    </style>

    <script>
        const STORAGE_KEY = 'bandvault_post_draft_blocks';
        const editorContainer = document.getElementById('editor-blocks');
        const editorsMap = {}; // Зберігатимемо екземпляри EasyMDE за ID блоку

        new Sortable(editorContainer, {
            animation: 150,
            handle: '.drag-handle',
            ghostClass: 'bg-dark',
            onEnd: saveDraft 
        });

        document.addEventListener("DOMContentLoaded", () => {
            const savedDraft = localStorage.getItem(STORAGE_KEY);
            if (savedDraft) {
                const blocks = JSON.parse(savedDraft);
                blocks.forEach(b => {
                    if (b.type === 'text') addTextBlock(b.content);
                    else if (b.type === 'media') addMediaBlock(b.content, b.preview);
                });
            }
            if (editorContainer.children.length === 0) {
                addTextBlock();
            }
        });

        function addTextBlock(content = "") {
            const blockId = 'block_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);
            const textareaId = 'ta_' + blockId;
            
            const html = `
                <div class="block-item" id="${blockId}" data-type="text">
                    <div class="drag-handle">⠿</div>
                    <div class="block-content">
                        <textarea id="${textareaId}" class="block-textarea">${content}</textarea>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removeBlock('${blockId}')">✕</button>
                </div>
            `;
            editorContainer.insertAdjacentHTML('beforeend', html);
            
            // Ініціалізуємо EasyMDE саме для цього блоку
            const mde = new EasyMDE({
                element: document.getElementById(textareaId),
                spellChecker: false,
                status: false, // ховаємо статус-бар для компактності
                toolbar: ["bold", "italic", "heading", "|", "quote", "unordered-list", "ordered-list", "|", "link", "image", "preview"],
                uploadImage: true,
                imageAccept: "image/*", // Текстовий блок приймає тільки картинки через Drag-n-Drop
                imageUploadFunction: function(file, onSuccess, onError) {
                    if (file.size > 20 * 1024 * 1024) { onError("До 20 МБ."); return; }
                    var formData = new FormData(); formData.append("file", file);
                    fetch('/Posts/UploadMedia', { method: 'POST', body: formData })
                        .then(res => res.json())
                        .then(data => onSuccess(data.url))
                        .catch(err => onError(err.toString()));
                }
            });
            
            // Зберігаємо чернетку при кожній зміні тексту
            mde.codemirror.on("change", saveDraft);
            editorsMap[blockId] = mde;
            saveDraft();
        }

        function addMediaBlock(markdownCode, previewHtml) {
            const blockId = 'block_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);
            const html = `
                <div class="block-item" id="${blockId}" data-type="media">
                    <div class="drag-handle">⠿</div>
                    <div class="block-content">
                        <input type="hidden" class="media-markdown" value="${markdownCode.replace(/"/g, '&quot;')}" />
                        <div class="media-preview">${previewHtml}</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removeBlock('${blockId}')">✕</button>
                </div>
            `;
            editorContainer.insertAdjacentHTML('beforeend', html);
            saveDraft();
        }

        function removeBlock(blockId) {
            if (editorsMap[blockId]) {
                editorsMap[blockId].toTextArea();
                delete editorsMap[blockId];
            }
            document.getElementById(blockId).remove();
            saveDraft();
        }

        function uploadMedia(input) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            if (file.size > 20 * 1024 * 1024) { alert("Файл занадто великий! Дозволено до 20 МБ."); return; }

            const formData = new FormData();
            formData.append("file", file);

            fetch('/Posts/UploadMedia', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => {
                    let markdown = "";
                    let preview = "";

                    if (data.type === 'video') {
                        markdown = `\n<video controls style="width:100%; max-height: 400px; border-radius:8px; margin: 10px 0;"><source src="${data.url}"></video>\n`;
                        preview = markdown;
                    } else if (data.type === 'audio') {
                        markdown = `\n<audio controls class="w-100" style="margin: 10px 0;"><source src="${data.url}"></audio>\n`;
                        preview = markdown;
                    }
                    if(markdown !== "") addMediaBlock(markdown, preview);
                    input.value = ""; 
                })
                .catch(err => alert("Помилка завантаження: " + err));
        }

        function saveDraft() {
            const blocks = [];
            Array.from(editorContainer.children).forEach(block => {
                const blockId = block.id;
                if (block.dataset.type === 'text') {
                    blocks.push({ type: 'text', content: editorsMap[blockId].value() });
                } else if (block.dataset.type === 'media') {
                    blocks.push({ 
                        type: 'media', 
                        content: block.querySelector('.media-markdown').value,
                        preview: block.querySelector('.media-preview').innerHTML
                    });
                }
            });
            localStorage.setItem(STORAGE_KEY, JSON.stringify(blocks));
        }

        function saveAndSubmit() {
            const form = document.getElementById('postForm');
            if (!form.reportValidity()) return;

            let finalMarkdown = "";
            Array.from(editorContainer.children).forEach(block => {
                if (block.dataset.type === 'text') {
                    finalMarkdown += editorsMap[block.id].value() + "\n\n";
                } else if (block.dataset.type === 'media') {
                    finalMarkdown += block.querySelector('.media-markdown').value + "\n\n";
                }
            });

            document.getElementById('ContentMarkdown').value = finalMarkdown.trim();
            localStorage.removeItem(STORAGE_KEY); 
            form.submit();
        }
    </script>
}