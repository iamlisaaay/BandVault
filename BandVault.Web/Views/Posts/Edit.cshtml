@model BandVault.Web.Models.Post
@{ ViewData["Title"] = "Редагування поста"; }

<div class="container my-5 w-75">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Редагувати пост</h3>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-0">&larr; Назад до стрічки</a>
    </div>

    <form asp-action="Edit" method="post" data-turbo="false" id="postForm">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label text-secondary meta-text">ЗАГОЛОВОК</label>
            <input asp-for="Title" class="form-control bg-dark text-white border-secondary rounded-0" required />
        </div>

        <div class="mb-3">
            <label asp-for="RequiredTierLevel" class="form-label text-secondary meta-text">ДОСТУП ДО ПОСТА (TIER)</label>
            <select asp-for="RequiredTierLevel" class="form-select bg-dark text-white border-secondary rounded-0" asp-items="ViewBag.Tiers">
            </select>
        </div>

        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <label class="form-label text-secondary meta-text">КОНТЕНТ (DRAG-N-DROP СОРТУВАННЯ ТА МЕДІА)</label>
                <span id="collabStatus" class="meta-text text-secondary">ПІДКЛЮЧЕННЯ СИНХРОНІЗАЦІЇ...</span>
            </div>
            <div id="editor-blocks" class="mb-3 p-3 border border-secondary" style="min-height: 200px; background-color: #121212;">
                <!-- Тут будуть створюватись блоки -->
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-light btn-sm rounded-0" onclick="addTextBlock()">+ Текст</button>
                <button type="button" class="btn btn-outline-light btn-sm rounded-0" onclick="document.getElementById('mediaUpload').click()">+ Медіа (Відео/Аудіо)</button>
                <input type="file" id="mediaUpload" style="display: none;" accept="audio/*, video/*" onchange="uploadMedia(this)" />
            </div>

            <input type="hidden" asp-for="ContentMarkdown" id="ContentMarkdown" />
            <input type="hidden" id="InitialContent" value="@Model.ContentMarkdown" />
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsPublished" class="form-check-input bg-dark border-secondary rounded-0" type="checkbox">
            <label class="form-check-label text-white" asp-for="IsPublished">
                Опублікувати одразу
            </label>
        </div>

        <button type="button" onclick="saveAndSubmit()" class="btn btn-light rounded-0 w-100 fw-bold">ЗБЕРЕГТИ ЗМІНИ</button>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/easymde@2.18.0/dist/easymde.min.css">
    <script src="https://unpkg.com/easymde@2.18.0/dist/easymde.min.js"></script>

    <style>
        .block-item {
            background-color: #1a1a1a;
            border: 1px solid #333;
            margin-bottom: 10px;
            padding: 10px;
            display: flex;
            align-items: stretch;
            gap: 10px;
            transition: border-color 0.2s;
        }

            .block-item:focus-within {
                border-color: #6c757d;
            }

        .drag-handle {
            cursor: grab;
            color: #666;
            padding: 5px;
            font-size: 1.2rem;
            user-select: none;
            display: flex;
            align-items: center;
        }

            .drag-handle:active {
                cursor: grabbing;
            }

        .block-content {
            flex-grow: 1;
            min-width: 0;
        }

        .editor-toolbar {
            border-color: #444;
            background-color: #1a1a1a;
            padding: 0 5px;
            opacity: 0.5;
            transition: opacity 0.3s;
        }

        .block-item:focus-within .editor-toolbar {
            opacity: 1;
            border-color: #6c757d;
        }

        .editor-toolbar button {
            color: #fff !important;
        }

            .editor-toolbar button:hover, .editor-toolbar button.active {
                background-color: #333;
            }

        .CodeMirror {
            background-color: #121212;
            color: #fff;
            border-color: #444;
            min-height: 80px;
            height: auto;
        }

        .block-item:focus-within .CodeMirror {
            border-color: #6c757d;
        }

        .editor-preview {
            background-color: #121212;
        }

        .CodeMirror-cursor {
            border-left: 2px solid #fff !important;
        }
        /* C14: блок, який зараз редагує інший користувач */
        .block-item { position: relative; }
        .block-item.peer-editing { border-color: var(--peer-color) !important; box-shadow: 0 0 12px -4px var(--peer-color); }
        .peer-label { position: absolute; top: -10px; right: 40px; font-size: 0.65rem; letter-spacing: 1px; text-transform: uppercase; background: var(--peer-color); color: #000; padding: 1px 6px; font-weight: 700; }
    </style>

    <script>
        window.PostEditorConfig = { storageKey: 'bandvault_post_edit_blocks_@Model.Id', docId: 'post-@Model.Id', initialContent: document.getElementById('InitialContent').value };
    </script>
    <script src="~/js/post-editor.js" asp-append-version="true"></script>
}
