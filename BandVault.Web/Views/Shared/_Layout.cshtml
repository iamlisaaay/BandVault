<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BandVault.Web</title>
    
    <!-- ФІКС C7: OpenGraph Метатеги для красивого прев'ю в соцмережах -->
    <meta property="og:title" content="@(ViewData["Title"] ?? "BandVault Fanclub")" />
    <meta property="og:description" content="Офіційний фан-клуб та магазин ексклюзивного мерчу." />
    <meta property="og:image" content="/images/avatars/default-og.jpg" />
    <meta property="og:type" content="website" />

    <script type="importmap"></script>

    <!-- ФІКС C9: Google Analytics (Заглушка для аналітики) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BANDVAULT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BANDVAULT');
    </script>

    <script type="module" src="https://unpkg.com/@@hotwired/turbo@8.0.4/dist/turbo.es2017-esm.js"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BandVault.Web.styles.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-black border-bottom border-secondary box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-white fw-bold" asp-area="" asp-controller="Home" asp-action="Index">BandVault.Web</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white text-uppercase fw-bold" style="font-size: 0.85rem; letter-spacing: 1px;" asp-area="" asp-controller="Merch" asp-action="Index">Мерч</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white text-uppercase fw-bold" style="font-size: 0.85rem; letter-spacing: 1px;" asp-area="" asp-controller="Releases" asp-action="Index">Каталог релізів</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white text-uppercase fw-bold" style="font-size: 0.85rem; letter-spacing: 1px;" asp-area="" asp-controller="Posts" asp-action="Index">Стрічка</a>
                            </li>
                        }

                        @if (User.HasClaim("IsAdmin", "true"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning text-uppercase fw-bold" style="font-size: 0.85rem; letter-spacing: 1px;" asp-area="" asp-controller="SiteSettings" asp-action="Index">Settings</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var layoutAvatarUrl = User.FindFirst("AvatarUrl")?.Value;
                            var layoutDisplayName = User.FindFirst("DisplayName")?.Value ?? "U";
                            if (string.IsNullOrEmpty(layoutAvatarUrl))
                            {
                                layoutAvatarUrl = $"https://via.placeholder.com/150/1a1a1a/ffffff?text={layoutDisplayName.Substring(0, 1).ToUpper()}";
                            }

                            <a asp-controller="Users" asp-action="Details" class="d-flex align-items-center link-light text-decoration-none">
                                <img src="@layoutAvatarUrl" alt="Avatar" width="35" height="35" class="rounded-circle border border-secondary" style="object-fit: cover;">
                                <span class="ms-2 meta-text text-uppercase fw-bold" style="font-size: 0.8rem; letter-spacing: 1px;">
                                    @layoutDisplayName
                                </span>
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm text-uppercase fw-bold rounded-0 px-4" asp-controller="Auth" asp-action="Login">УВІЙТИ</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- ФІКС: Динамічні контакти з бази даних замість захардкоджених -->
    <div class="position-fixed end-0 top-50 translate-middle-y bg-black border border-secondary p-3 d-none d-md-flex flex-column gap-4 shadow-lg" style="z-index: 1040; border-right: none !important; border-top-left-radius: 8px; border-bottom-left-radius: 8px;">
        <a href="@(ViewBag.Social_YouTube ?? "https://youtube.com")" target="_blank" class="text-secondary text-decoration-none text-center meta-text fw-bold fs-6" style="transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#6c757d'">YT</a>
        <a href="@(ViewBag.Social_Instagram ?? "https://instagram.com")" target="_blank" class="text-secondary text-decoration-none text-center meta-text fw-bold fs-6" style="transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#6c757d'">IG</a>
        <a href="@(ViewBag.Social_Discord ?? "https://discord.com")" target="_blank" class="text-secondary text-decoration-none text-center meta-text fw-bold fs-6" style="transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#6c757d'">DS</a>
        <a href="mailto:@(ViewBag.ContactEmail ?? "info@bandvault.com")" class="text-white text-decoration-none text-center meta-text fs-5" title="@(ViewBag.ContactEmail ?? "info@bandvault.com")">✉</a>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-secondary footer text-muted mt-5">
        <div class="container py-3">
            &copy; 2026 - BandVault.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-secondary">Privacy</a>
        </div>
    </footer>

    <!-- аудіо-плеєр -->
    <div id="global-player" data-turbo-permanent class="global-audio-footer bg-black border-top border-secondary shadow-lg py-2">
        <div class="container d-flex align-items-center">
            <img id="player-cover" src="https://via.placeholder.com/50/000000/ffffff?text=BV" alt="Cover" class="rounded me-3 border border-secondary" style="width: 50px; height: 50px; object-fit: cover;">
            <div class="player-info text-white me-3 d-none d-md-block" style="min-width: 180px; max-width: 250px;">
                <h6 class="mb-0 text-light" style="font-size: 0.75rem; letter-spacing: 1px;">NOW PLAYING</h6>
                <div id="player-track-title" class="fw-bold text-truncate" style="font-size: 0.95rem;">Оберіть трек</div>
                <a id="player-track-artist" href="#" class="text-secondary text-truncate d-block text-decoration-none release-link" style="font-size: 0.875em; transition: color 0.2s;">BandVault</a>
            </div>
            <div class="flex-grow-1 mx-4 d-none d-lg-block">
                <canvas id="visualizer" width="600" height="40" class="w-100 rounded"></canvas>
            </div>
            <div class="player-controls ms-auto">
                <audio id="main-audio" controls>
                    <source id="main-audio-source" src="" type="audio/mpeg">
                </audio>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>