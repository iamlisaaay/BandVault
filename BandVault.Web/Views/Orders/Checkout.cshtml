@model IEnumerable<BandVault.Web.Controllers.CartController.CartItemDto>

<div class="container my-5 w-75">
    <h2 class="text-uppercase fw-bold border-bottom border-secondary pb-3 mb-4">ОФОРМЛЕННЯ ЗАМОВЛЕННЯ</h2>

    <div class="row g-5">
        <div class="col-md-7">
            <form asp-action="PlaceOrder" method="post" id="orderForm" data-turbo="false">
                
                <h5 class="text-secondary meta-text mb-4">1. КОНТАКТНІ ДАНІ</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-secondary meta-text">ІМ'Я ТА ПРІЗВИЩЕ</label>
                        <input type="text" name="customerName" class="form-control bg-dark text-white border-secondary rounded-0" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-secondary meta-text">НОМЕР ТЕЛЕФОНУ</label>
                        <input type="tel" name="customerPhone" class="form-control bg-dark text-white border-secondary rounded-0" required placeholder="+380..." />
                    </div>
                </div>
                <div class="mb-5">
                    <label class="form-label text-secondary meta-text">EMAIL ДЛЯ КВИТАНЦІЇ</label>
                    <input type="email" name="customerEmail" value="@User.Identity.Name" class="form-control bg-dark text-white border-secondary rounded-0" required />
                </div>

                <h5 class="text-secondary meta-text mb-4">2. ДОСТАВКА ТА ОПЛАТА</h5>
                
                <div class="mb-3">
                    <label class="form-label text-secondary meta-text">ТОЧНА АДРЕСА АБО № ВІДДІЛЕННЯ</label>
                    <input type="text" id="addressInput" name="address" class="form-control bg-dark text-white border-secondary rounded-0" required placeholder="Наприклад: м. Київ, вул. Хрещатик 1, кв 5" />
                </div>

                <!-- Мапа для опціонального вибору координат (темна через CSS) -->
                <p class="text-secondary meta-text mb-2 mt-4"><small>*Можете додатково вказати точку на мапі для кур'єра:</small></p>
                <div id="map" class="border border-secondary mb-4" style="height: 250px; width: 100%; background: #111; filter: invert(100%) hue-rotate(180deg) brightness(95%) contrast(90%);"></div>
                
                <input type="hidden" id="latInput" name="lat" value="50.4501" />
                <input type="hidden" id="lngInput" name="lng" value="30.5234" />

                <div class="mb-4">
                    <label class="form-label text-secondary meta-text">СПОСІБ ОПЛАТИ</label>
                    <select name="paymentMethod" class="form-select bg-dark text-white border-secondary rounded-0">
                        <option value="Готівкою кур'єру">Готівкою при отриманні</option>
                        <option value="Карткою кур'єру">Карткою при отриманні (через термінал)</option>
                        <option value="Переказ на IBAN">Переказ за реквізитами IBAN</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-light w-100 rounded-0 text-uppercase fw-bold py-3 mt-3" style="letter-spacing: 2px;">
                    ОФОРМИТИ ЗАМОВЛЕННЯ
                </button>
            </form>
        </div>

        <div class="col-md-5">
            <div class="card bg-transparent border-secondary rounded-0 p-4 sticky-top" style="top: 20px;">
                <h5 class="text-secondary meta-text mb-4 text-center">ВАШЕ ЗАМОВЛЕННЯ</h5>
                
                @foreach (var item in Model)
                {
                    <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-secondary">
                        <span class="text-white text-truncate me-2">@item.Quantity x @item.Title</span>
                        <span class="text-success fw-bold text-nowrap">@((item.Price * item.Quantity).ToString("0.00")) $</span>
                    </div>
                }
                
                <div class="d-flex justify-content-between mt-4">
                    <h5 class="text-white fw-bold mb-0">ДО СПЛАТИ:</h5>
                    <h4 class="text-white fw-bold mb-0">@ViewBag.Total.ToString("0.00") $</h4>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        var map = L.map('map').setView([50.4501, 30.5234], 11);

        // Стандартний OSM (Крим - це Україна)
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        var marker;

        map.on('click', function(e) {
            if (marker) map.removeLayer(marker);
            
            // Інвертуємо маркер назад, бо мапа інвертована через CSS
            var customIcon = L.divIcon({
                className: 'custom-div-icon',
                html: `<div style="background-color:#0dcaf0; width:15px; height:15px; border-radius:50%; border:2px solid #000; filter: invert(100%) hue-rotate(180deg);"></div>`,
                iconSize: [15, 15]
            });
            
            marker = L.marker(e.latlng, { icon: customIcon }).addTo(map);
            
            document.getElementById('latInput').value = e.latlng.lat;
            document.getElementById('lngInput').value = e.latlng.lng;
        });
    </script>
}