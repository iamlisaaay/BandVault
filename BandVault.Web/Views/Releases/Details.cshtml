@model BandVault.Web.Models.Release
@{ ViewData["Title"] = Model.Title; ViewData["Description"] = string.IsNullOrWhiteSpace(Model.Description) ? $"Реліз {Model.Title}" : (Model.Description.Length > 160 ? Model.Description[..157] + "..." : Model.Description); ViewData["OgImage"] = Model.CoverImageUrl; ViewData["OgType"] = "music.album"; }

<div class="container my-5">
    <div class="row g-5">
      
        <div class="col-md-4 text-center">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" class="img-fluid border border-secondary w-100" style="max-width: 350px;" alt="@Model.Title" />
            }
            else
            {
                <div class="bg-dark border border-secondary d-flex align-items-center justify-content-center" style="height: 350px;">
                    <span class="meta-text">Немає обкладинки</span>
                </div>
            }
            <h2 class="mt-4 text-white fw-bold text-uppercase" style="letter-spacing: 1px;">@Model.Title</h2>
            <div class="d-flex justify-content-center gap-3 mt-2">
                <span class="meta-text">@Model.ReleaseDate.ToShortDateString()</span>
                <span class="meta-text">|</span>
                <span class="meta-text">@Model.Genre?.Name</span>
            </div>
            <p class="text-light opacity-75 small text-start mt-4 markdown-content">@Model.Description</p>
        </div>

        <div class="col-md-8">
            <h3 class="section-title">Трекліст</h3>
            
            <div class="d-flex flex-column mb-5">
                @if (Model.Tracks != null && Model.Tracks.Any())
                {
                    @foreach (var track in Model.Tracks)
                    {
                        <div class="list-item-hover d-flex justify-content-between align-items-center py-3 px-2">
                            <span class="text-white">@track.Title</span>
                            
                            <div class="d-flex gap-3 align-items-center">
                               @if (track.RequiredTierLevel > (int)ViewBag.UserTier)
                               {
                                   <!-- B6: закритий трек - URL аудіо не віддаємо в розмітку -->
                                   <a href="/?changeTier=1" class="btn-text-muted text-warning text-decoration-none" style="font-size: 0.8rem;" data-turbo="false">🔒 TIER @track.RequiredTierLevel+</a>
                               }
                               else
                               {
                                   @if (track.DurationSeconds > 0)
                                   {
                                       <span class="meta-text mb-0">@TimeSpan.FromSeconds(track.DurationSeconds).ToString(@"m\:ss")</span>
                                   }
                                   <button class="btn-text-muted" style="font-size: 0.8rem;"
                                           data-play-track="@track.Id" data-audio="@track.AudioFileUrl" data-title="@track.Title"
                                           data-artist="@Model.Title" data-cover="@Model.CoverImageUrl" data-release-url="/Releases/Details/@Model.Id">
                                       ▶ Слухати
                                   </button>
                               }

                               @if (ViewBag.IsAdmin)
                               {
                                   <form asp-action="DeleteTrack" method="post" class="m-0 p-0" onsubmit="return confirm('Видалити цей трек?');">
                                       <input type="hidden" name="trackId" value="@track.Id" />
                                       <input type="hidden" name="releaseId" value="@Model.Id" />
                                       <button type="submit" class="btn-text-muted text-danger" style="font-size: 0.8rem;">✕</button>
                                   </form>
                               }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="py-3 px-2 text-secondary meta-text">Треків ще немає.</div>
                }
            </div>

            @if (ViewBag.IsAdmin)
            {
                <h4 class="section-title" style="font-size: 0.85rem;">Додати новий трек</h4>
                <div class="p-4 border border-secondary bg-transparent">
                    <form asp-action="AddTrack" enctype="multipart/form-data" class="row g-3 align-items-end">
                        <input type="hidden" name="releaseId" value="@Model.Id" />
                        
                        <div class="col-md-5">
                            <label class="form-label meta-text mb-1">Назва треку</label>
                            <input type="text" name="title" class="form-control form-control-dark rounded-0" required />
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label meta-text mb-1">Аудіофайл (MP3)</label>
                            <input type="file" name="audioFile" id="audioFileInput" class="form-control form-control-dark rounded-0" accept="audio/*" required />
                            <input type="hidden" name="durationSeconds" id="durationSeconds" value="0" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label meta-text mb-1">Доступ</label>
                            <select name="requiredTierLevel" class="form-select form-select-dark rounded-0">
                                <option value="0">Усім</option>
                                @foreach (var tier in (List<BandVault.Web.Models.SubscriptionTier>)ViewBag.Tiers)
                                {
                                    if (tier.Level > 0)
                                    {
                                        <option value="@tier.Level">@tier.Name+</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-1">
                            <button type="submit" class="btn btn-light w-100 rounded-0 text-uppercase fw-bold" style="font-size: 0.8rem; height: 38px;">Додати</button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>
</div>
<script>
    // Тривалість треку визначаємо в браузері з вибраного файлу (File API + <audio>), щоб не парсити аудіо на сервері
    (function () {
        const input = document.getElementById('audioFileInput');
        if (!input) return;
        input.addEventListener('change', () => {
            const file = input.files && input.files[0];
            document.getElementById('durationSeconds').value = 0;
            if (!file) return;
            const url = URL.createObjectURL(file);
            const probe = new Audio();
            probe.preload = 'metadata';
            probe.onloadedmetadata = () => {
                if (isFinite(probe.duration)) document.getElementById('durationSeconds').value = Math.round(probe.duration);
                URL.revokeObjectURL(url);
            };
            probe.src = url;
        });
    })();
</script>
