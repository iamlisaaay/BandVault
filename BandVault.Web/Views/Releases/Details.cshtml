@model BandVault.Web.Models.Release

<div class="container my-5">
    <div class="row g-5">
        <!-- Обкладинка та інфо -->
        <div class="col-md-4 text-center">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" class="img-fluid border border-secondary w-100" style="max-width: 350px;" alt="@Model.Title" />
            }
            else
            {
                <div class="bg-dark border border-secondary d-flex align-items-center justify-content-center" style="height: 350px;">
                    <span class="meta-text">Немає обкладинки</span>
                </div>
            }
            <h2 class="mt-4 text-white fw-bold text-uppercase" style="letter-spacing: 1px;">@Model.Title</h2>
            <div class="d-flex justify-content-center gap-3 mt-2">
                <span class="meta-text">@Model.ReleaseDate.ToShortDateString()</span>
                <span class="meta-text">|</span>
                <span class="meta-text">@Model.Genre?.Name</span>
            </div>
            <p class="text-light opacity-75 small text-start mt-4 markdown-content">@Model.Description</p>
        </div>

        <!-- Трекліст та додавання треків -->
        <div class="col-md-8">
            <h3 class="section-title">Трекліст</h3>
            
            <div class="d-flex flex-column mb-5">
                @if (Model.Tracks != null && Model.Tracks.Any())
                {
                    @foreach (var track in Model.Tracks)
                    {
                        <div class="list-item-hover d-flex justify-content-between align-items-center py-3 px-2">
                            <span class="text-white">@track.Title</span>
                            
                            <div class="d-flex gap-3 align-items-center">
                                <!-- Виклик плеєра -->
                               <button class="btn-text-muted" style="font-size: 0.8rem;"
        onclick="playTrack('@track.AudioFileUrl', '@track.Title', '@Model.Title', '@Model.CoverImageUrl', '/Releases/Details/@Model.Id')">
    ▶ Слухати
</button>

                                <!-- Кнопка видалення треку -->
                                <form asp-action="DeleteTrack" method="post" class="m-0 p-0" onsubmit="return confirm('Видалити цей трек?');">
                                    <input type="hidden" name="trackId" value="@track.Id" />
                                    <input type="hidden" name="releaseId" value="@Model.Id" />
                                    <button type="submit" class="btn-text-muted text-danger" style="font-size: 0.8rem;">✕</button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="py-3 px-2 text-secondary meta-text">Треків ще немає.</div>
                }
            </div>

            <!-- Форма швидкого додавання MP3 -->
            <h4 class="section-title" style="font-size: 0.85rem;">Додати новий трек</h4>
            <div class="p-4 border border-secondary bg-transparent">
                <form asp-action="AddTrack" enctype="multipart/form-data" class="row g-3 align-items-end">
                    <input type="hidden" name="releaseId" value="@Model.Id" />
                    
                    <div class="col-md-5">
                        <label class="form-label meta-text mb-1">Назва треку</label>
                        <input type="text" name="title" class="form-control form-control-dark rounded-0" required />
                    </div>
                    
                    <div class="col-md-5">
                        <label class="form-label meta-text mb-1">Аудіофайл (MP3)</label>
                        <input type="file" name="audioFile" class="form-control form-control-dark rounded-0" accept="audio/*" required />
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-light w-100 rounded-0 text-uppercase fw-bold" style="font-size: 0.8rem; height: 38px;">Додати</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>