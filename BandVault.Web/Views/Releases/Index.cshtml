@model IEnumerable<BandVault.Web.Models.Release>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom border-secondary pb-2">
        <h3 class="section-title border-0 mb-0 pb-0">Каталог релізів</h3>
        <a asp-action="Create" class="btn btn-sm btn-light text-uppercase fw-bold" style="letter-spacing: 1px;">
            + Додати реліз
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 bg-transparent border-secondary text-white hover-lift rounded-0">
                    <!-- Обкладинка -->
                    @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                    {
                        <img src="@item.CoverImageUrl" class="card-img-top rounded-0" alt="@item.Title" style="height: 250px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-dark d-flex align-items-center justify-content-center rounded-0 border-bottom border-secondary" style="height: 250px;">
                            <span class="text-secondary meta-text">Без обкладинки</span>
                        </div>
                    }
                    
                    <div class="card-body pb-1">
                        <h5 class="card-title fw-bold text-truncate" title="@item.Title">@item.Title</h5>
                        <p class="card-text mb-1 meta-text">Жанр: @item.Genre?.Name</p>
                        <p class="card-text meta-text">Реліз: @item.ReleaseDate.ToShortDateString()</p>
                    </div>
                    
                    <div class="card-footer bg-transparent border-0 pt-0 d-flex flex-column gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-light w-100 rounded-0 text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">
                            Відкрити
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary w-50 rounded-0">Ред.</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger w-50 rounded-0 border-secondary text-secondary">Вид.</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>