@inject IConfiguration Config

@{
    ViewData["Title"] = "Вхід у систему";
    bool googleConfigured = BandVault.Web.Controllers.AuthController.GoogleConfigured(Config);
}

<div class="container my-5 w-50">
    <div class="card bg-transparent border-secondary text-white rounded-0 p-5">
        <h2 class="fw-bold mb-4 text-center">АВТОРИЗАЦІЯ</h2>

        @if (TempData["LoginError"] is string loginError)
        {
            <div class="alert bg-dark border-warning text-warning rounded-0 meta-text mb-4">@loginError</div>
        }

        <!-- C16: вхід і реєстрація через Google OAuth2 -->
        <form asp-controller="Auth" asp-action="ExternalLogin" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" data-turbo="false" class="d-grid">
            <button type="submit" class="btn btn-light rounded-0 fw-bold d-flex align-items-center justify-content-center gap-2 py-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
                    <path d="M15.545 6.558a9.4 9.4 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.7 7.7 0 0 1 5.352 2.082l-2.284 2.284A4.35 4.35 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.8 4.8 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.7 3.7 0 0 0 1.599-2.431H8v-3.08h7.545z"/>
                </svg>
                УВІЙТИ ЧЕРЕЗ GOOGLE
            </button>
        </form>

        <p class="meta-text text-center mt-3 mb-0">ПЕРШИЙ ВХІД АВТОМАТИЧНО СТВОРЮЄ АКАУНТ ФАН-КЛУБУ</p>

        @if (!googleConfigured)
        {
            <p class="meta-text text-center text-warning mt-3 mb-0">GOOGLE OAUTH ЩЕ НЕ НАЛАШТОВАНО: ДОДАЙТЕ CLIENTID ТА CLIENTSECRET (ДИВ. DOCS/IMPLEMENTATION.MD)</p>
        }
    </div>
</div>
