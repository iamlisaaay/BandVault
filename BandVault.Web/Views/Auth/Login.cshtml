@{
    ViewData["Title"] = "Вхід у систему";
}

<div class="container my-5 w-50">
    <div class="card bg-transparent border-secondary text-white rounded-0 p-5">
        <h2 class="fw-bold mb-4 text-center">АВТОРИЗАЦІЯ</h2>
        
        <!-- Обычный вход по Email (для тестов) -->
        <form asp-controller="Auth" asp-action="Login" method="post" data-turbo="false">
            <div class="mb-4">
                <label class="form-label text-secondary meta-text">ВВЕДІТЬ ВАШ EMAIL</label>
                <input type="email" name="email" class="form-control bg-dark text-white border-secondary rounded-0 py-2" required placeholder="danchenko_anastasiia@knu.ua" />
            </div>
            
            <button type="submit" class="btn btn-light rounded-0 w-100 fw-bold py-2">УВІЙТИ</button>
        </form>

        <hr class="border-secondary my-4">

        <!-- Вход через Google OAuth2 -->
        <form asp-controller="Auth" asp-action="ExternalLogin" method="post" data-turbo="false" class="d-grid">
            <button type="submit" class="btn btn-outline-light rounded-0 fw-bold d-flex align-items-center justify-content-center gap-2 py-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
                    <path d="M15.545 6.558a9.4 9.4 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.7 7.7 0 0 1 5.352 2.082l-2.284 2.284A4.35 4.35 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.8 4.8 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.7 3.7 0 0 0 1.599-2.431H8v-3.08h7.545z"/>
                </svg>
                УВІЙТИ ЧЕРЕЗ GOOGLE
            </button>
        </form>
    </div>
</div>