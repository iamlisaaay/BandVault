@model BandVault.Web.Models.MerchItem

@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Description.Length > 160 ? Model.Description[..157] + "..." : Model.Description;
    ViewData["OgImage"] = Model.ImageUrl;
    ViewData["OgType"] = "product";
    var related = (List<BandVault.Web.Models.MerchItem>)ViewBag.Related;
}

<div class="container my-5" style="max-width: 1000px;">
    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-0 text-uppercase fw-bold" style="letter-spacing: 1px;">
            &larr; Назад до каталогу
        </a>
        <!-- C6: навігація по розділах лендінгу -->
        <nav class="d-flex gap-3 meta-text mb-0">
            <a href="#about" class="text-secondary text-decoration-none">ОПИС</a>
            <a href="#delivery" class="text-secondary text-decoration-none">ДОСТАВКА</a>
            @if (related.Any())
            {
                <a href="#related" class="text-secondary text-decoration-none">СХОЖІ</a>
            }
        </nav></div>

    <div class="card bg-transparent border-secondary text-white rounded-0">
        <div class="row g-0">
            <div class="col-md-5 border-end border-secondary">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded-0 w-100 h-100" alt="@Model.Title" style="object-fit: cover; min-height: 400px;">
                }
                else
                {
                    <div class="bg-dark d-flex align-items-center justify-content-center h-100" style="min-height: 400px;">
                        <span class="text-secondary meta-text">БЕЗ ФОТО</span>
                    </div>
                }
            </div>
            
            <div class="col-md-7">
                <div class="card-body p-4 p-lg-5 d-flex flex-column h-100">
                    <h2 class="fw-bold text-uppercase mb-3" style="letter-spacing: 1px;">@Model.Title</h2>
                    
                    <div class="mb-4 d-flex gap-2">
                        <span class="badge border border-secondary text-secondary rounded-0 meta-text p-2 mb-0">
                            @(Model.Category?.Name ?? "БЕЗ КАТЕГОРІЇ")
                        </span>
                        
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="badge bg-success rounded-0 meta-text p-2 mb-0">В НАЯВНОСТІ: @Model.StockQuantity ШТ.</span>
                        }
                        else
                        {
                            <span class="badge bg-danger rounded-0 meta-text p-2 mb-0">НЕМАЄ В НАЯВНОСТІ</span>
                        }
                    </div>

                   @if (ViewBag.FanPrices == true && Model.FanPrice.HasValue)
                    {
                        <h3 class="fw-bold text-white mb-4">
                            <s class="text-secondary fs-5">@Model.Price.ToString("0.00") $</s> 
                            <span class="text-success ms-2">@Model.FanPrice.Value.ToString("0.00") $</span>
                        </h3>
                    }
                    else
                    {
                        <h3 class="fw-bold text-white mb-4">@Model.Price.ToString("0.00") $</h3>
                    }

                    <div class="mb-4 flex-grow-1" id="about" style="scroll-margin-top: 80px;">
                        <h6 class="text-uppercase meta-text text-secondary border-bottom border-secondary pb-2 mb-3">Опис товару</h6>
                        <p class="card-text text-light" style="white-space: pre-wrap; line-height: 1.6;">@Model.Description</p>
                    </div>

                    @if (Model.StockQuantity > 0)
                    {
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-4" data-turbo="false">
                            <input type="hidden" name="merchId" value="@Model.Id" />
                            <div class="d-flex align-items-center gap-3">
                                <input type="number" name="quantity" value="1" min="1" max="@Model.StockQuantity" class="form-control bg-dark text-white border-secondary rounded-0 text-center fw-bold py-2" style="width: 90px;" />
                                <button type="submit" class="btn btn-light rounded-0 text-uppercase fw-bold px-4 py-2 flex-grow-1" style="letter-spacing: 2px;">
                                    У КОШИК 🛒
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary rounded-0 text-uppercase fw-bold py-2 mb-4" disabled>
                            РОЗПРОДАНО
                        </button>
                    }

                    @if (User.HasClaim("IsAdmin", "true"))
                    {
                        <div class="d-flex gap-3 mt-auto pt-4 border-top border-secondary">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-light rounded-0 text-uppercase fw-bold px-4" style="letter-spacing: 1px;" data-turbo="false">
                                Редагувати
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-0 text-uppercase border-secondary px-4" style="letter-spacing: 1px;">
                                Видалити
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- C6: доставка, оплата, повернення -->
    <section id="delivery" class="mt-5 pt-3" style="scroll-margin-top: 80px;">
        <h3 class="section-title">Доставка та оплата</h3>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card h-100 bg-transparent border-secondary rounded-0 p-4 text-white">
                    <p class="meta-text">ДОСТАВКА</p>
                    <p class="mb-0 text-light" style="font-size: 0.9rem;">Кур'єром або у відділення пошти по всій Україні. Точку доставки обираєте на мапі під час оформлення.</p>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 bg-transparent border-secondary rounded-0 p-4 text-white">
                    <p class="meta-text">ОПЛАТА</p>
                    <p class="mb-0 text-light" style="font-size: 0.9rem;">Готівкою або карткою при отриманні, чи переказом на IBAN. Рахунок-фактура PDF приходить одразу після замовлення.</p>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 bg-transparent border-secondary rounded-0 p-4 text-white">
                    <p class="meta-text">ПОВЕРНЕННЯ</p>
                    <p class="mb-0 text-light" style="font-size: 0.9rem;">14 днів на обмін чи повернення, якщо товар не був у використанні. Пишіть на пошту з бічної панелі контактів.</p>
                </div>
            </div>
        </div>
    </section>

    @if (related.Any())
    {
        <section id="related" class="mt-5 pt-3" style="scroll-margin-top: 80px;">
            <h3 class="section-title">Схожі товари</h3>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var item in related)
                {
                    <div class="col">
                        <a asp-action="Details" asp-route-id="@item.Id" class="card h-100 bg-transparent border-secondary text-white hover-lift rounded-0 text-decoration-none">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top rounded-0" alt="@item.Title" style="height: 200px; object-fit: cover;" loading="lazy">
                            }
                            <div class="card-body">
                                <h6 class="fw-bold text-truncate mb-1">@item.Title</h6>
                                <span class="meta-text mb-0">@item.Price.ToString("0.00") $</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </section>
    }</div>