@model BandVault.Web.Models.User

<div class="container my-5 w-75">
    <div class="card bg-transparent border-secondary rounded-0 text-white p-5">
        <div class="d-flex align-items-start gap-4 flex-wrap">
            <!-- Аватарка -->
            <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle border border-secondary" style="width: 120px; height: 120px; object-fit: cover;">
            
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h2 class="fw-bold mb-0">@Model.DisplayName</h2>
                    @if (Model.SubscriptionTier != null && Model.SubscriptionTier.Level > 0)
                    {
                        <span class="badge bg-warning text-dark border-0 rounded-0 meta-text px-3 py-2 mt-1">
                            TIER @Model.SubscriptionTier.Level: @Model.SubscriptionTier.Name
                        </span>
                    }
                    else if (Model.IsAdmin)
                    {
                         <span class="badge bg-danger text-white border-0 rounded-0 meta-text px-3 py-2 mt-1">
                            OFFICIAL ACCOUNT
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-light border-0 rounded-0 meta-text px-3 py-2 mt-1">
                            REGISTERED
                        </span>
                    }
                </div>
                
                <p class="text-secondary meta-text mb-4">В клубі з: @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</p>
                
                <div class="bio-section p-3 bg-dark border border-secondary">
                    <h6 class="text-secondary meta-text mb-2">ПРО СЕБЕ:</h6>
                    <p class="mb-0 text-white-50" style="white-space: pre-wrap;">@(string.IsNullOrEmpty(Model.Bio) ? "Користувач ще нічого не розповів про себе." : Model.Bio)</p>
                </div>
            </div>
        </div>

        <!-- ФОРМА РЕДАГУВАННЯ (тільки для свого профілю) -->
        @if (ViewBag.IsOwnProfile)
        {
            <hr class="border-secondary my-5">
            <h4 class="fw-bold mb-4">Налаштування профілю</h4>
            <form asp-action="EditProfile" enctype="multipart/form-data" method="post">
                <div class="mb-3">
                    <label class="form-label text-secondary meta-text">ІМ'Я НА САЙТІ (DISPLAY NAME)</label>
                    <input type="text" name="displayName" class="form-control bg-dark text-white border-secondary rounded-0" value="@Model.DisplayName" required>
                </div>
                <div class="mb-3">
                    <label class="form-label text-secondary meta-text">КОРОТКА БІОГРАФІЯ</label>
                    <textarea name="bio" class="form-control bg-dark text-white border-secondary rounded-0" rows="3">@Model.Bio</textarea>
                </div>
                <div class="mb-4">
                    <label class="form-label text-secondary meta-text">ЗМІНИТИ АВАТАРКУ</label>
                    <input type="file" name="avatarFile" class="form-control bg-dark text-white border-secondary rounded-0" accept="image/*">
                </div>
                <button type="submit" class="btn btn-light w-100 rounded-0 fw-bold">ЗБЕРЕГТИ ЗМІНИ</button>
            </form>
        }
    </div>
</div>