@model IEnumerable<BandVault.Web.Models.SiteSetting>
@using System.Text.Json

@{
    ViewData["Title"] = "Керування сайтом";
}

<div class="container my-5 text-white">
    <div class="row mb-5 align-items-center">
        <div class="col-md-7">
            <h2 class="text-uppercase fw-bold mb-4" style="letter-spacing: 2px;">Налаштування Лендінгу</h2>
            <p class="text-secondary meta-text mb-4">Тут ви можете змінити фонове відео, тексти та посилання на соцмережі.</p>
        </div>
        
        <!-- ФІКС F1: Блок з графіком -->
        <div class="col-md-5">
            <div class="card bg-transparent border-secondary p-3 rounded-0 shadow-lg">
                <h6 class="text-center text-uppercase meta-text text-secondary mb-3">Статистика підписок фан-клубу</h6>
                <div style="height: 200px; display: flex; justify-content: center;">
                    <canvas id="usersChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <!-- F1: прослуховування треків та динаміка замовлень -->
    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="card bg-transparent border-secondary p-3 rounded-0 shadow-lg h-100">
                <h6 class="text-center text-uppercase meta-text text-secondary mb-3">Топ треків за прослуховуваннями</h6>
                @if (((string[])ViewBag.PlaysLabels).Length == 0)
                {
                    <p class="meta-text text-center my-auto">ТРЕКІВ ЩЕ НЕМАЄ - ДОДАЙТЕ ЇХ У КАТАЛОЗІ РЕЛІЗІВ</p>
                }
                <div style="height: 260px;"><canvas id="playsChart"></canvas></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card bg-transparent border-secondary p-3 rounded-0 shadow-lg h-100">
                <h6 class="text-center text-uppercase meta-text text-secondary mb-3">Замовлення мерчу за 14 днів</h6>
                <div style="height: 260px;"><canvas id="ordersChart"></canvas></div>
            </div>
        </div>
    </div>



    <div class="table-responsive">
        <table class="table table-dark table-striped table-bordered border-secondary align-middle">
            <thead>
                <tr class="text-secondary text-uppercase meta-text" style="letter-spacing: 1px;">
                    <th style="width: 25%;">Ключ (Системна назва)</th>
                    <th style="width: 60%;">Значення (Текст або URL)</th>
                    <th style="width: 15%; text-align: center;">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-light">@item.Key</td>
                        <td class="text-truncate" style="max-width: 300px; color: #aaa;">@item.Value</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light rounded-0 text-uppercase" style="letter-spacing: 1px;">Змінити</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () { // виконується при кожному відкритті сторінки (і через Turbo)
            const ctx = document.getElementById('usersChart').getContext('2d');
            
            // Отримуємо дані з бекенду
            const labels = @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartLabels));
            const dataValues = @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartData));

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: dataValues,
                        backgroundColor: ['#ffc107', '#198754', '#0dcaf0', '#dc3545', '#6c757d'],
                        borderColor: '#1a1a1a',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { color: '#fff', font: { size: 10 } } }
                    }
                }
            });

            const axis = { ticks: { color: '#888', font: { size: 10 } }, grid: { color: '#222' } };

            new Chart(document.getElementById('playsChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(JsonSerializer.Serialize(ViewBag.PlaysLabels)),
                    datasets: [{ label: 'Прослуховування', data: @Html.Raw(JsonSerializer.Serialize(ViewBag.PlaysData)), backgroundColor: '#ffc107' }]
                },
                options: {
                    indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { ...axis, beginAtZero: true, ticks: { ...axis.ticks, precision: 0 } }, y: axis }
                }
            });

            new Chart(document.getElementById('ordersChart'), {
                data: {
                    labels: @Html.Raw(JsonSerializer.Serialize(ViewBag.OrdersLabels)),
                    datasets: [
                        { type: 'bar', label: 'Замовлень', data: @Html.Raw(JsonSerializer.Serialize(ViewBag.OrdersCount)), backgroundColor: '#444', yAxisID: 'y' },
                        { type: 'line', label: 'Виручка, $', data: @Html.Raw(JsonSerializer.Serialize(ViewBag.OrdersRevenue)), borderColor: '#198754', backgroundColor: '#198754', tension: 0.3, yAxisID: 'y1' }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#fff', font: { size: 10 } } } },
                    scales: {
                        x: axis,
                        y: { ...axis, beginAtZero: true, ticks: { ...axis.ticks, precision: 0 } },
                        y1: { ...axis, beginAtZero: true, position: 'right', grid: { drawOnChartArea: false } }
                    }
                }
            });
        })();
    </script>
}
