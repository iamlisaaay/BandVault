# Скопіюйте у .env (він у .gitignore) і заповніть. docker compose підхоплює .env автоматично.
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=bandvault
RABBITMQ_PASSWORD=change-me

# Ключ для запису через REST API та MCP (заголовок X-Api-Key)
API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
# ШІ-асистент: безкоштовний ключ Gemini з aistudio.google.com/apikey (адреса й модель - за замовчуванням)
# Локальна Ollama замість Gemini: ASSISTANT_BASE_URL=http://ollama:11434/v1  ASSISTANT_MODEL=qwen3:4b  (docker compose --profile ai up -d)
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
