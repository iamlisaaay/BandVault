# Скопіюйте у .env (він у .gitignore) і заповніть. docker compose підхоплює .env автоматично.
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=bandvault
RABBITMQ_PASSWORD=change-me

# Ключ для запису через REST API та MCP (заголовок X-Api-Key)
API_KEY=

# true - показати DEV LOGIN без пароля (лише для локальної демонстрації!)
ENABLE_DEV_LOGIN=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
