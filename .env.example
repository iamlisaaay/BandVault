# Скопіюйте у .env (він у .gitignore) і заповніть. docker compose підхоплює .env автоматично.
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=bandvault
RABBITMQ_PASSWORD=change-me

# Ключ для запису через REST API та MCP (заголовок X-Api-Key)
API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
# ШІ-асистент (безкоштовно). Порожньо = Ollama з docker compose --profile ai
# Gemini: ASSISTANT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  ASSISTANT_MODEL=gemini-2.5-flash
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
